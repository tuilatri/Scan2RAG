{
  "project": {
    "name": "Scan2RAG",
    "chatLanguage": "vi"
  },
  "apps": [
    {
      "id": "backend",
      "path": "backend",
      "srcPath": "backend/app",
      "verify": ".venv/Scripts/python.exe -m pytest tests/ -q",
      "expectedTests": null
    },
    {
      "id": "frontend",
      "path": "frontend",
      "srcPath": "frontend/src",
      "verify": "npm test",
      "expectedTests": null
    }
  ],
  "docPaths": {
    "aiContext": "docs/ai-context",
    "agents": "AGENTS.md",
    "agentsConfig": "docs/agents"
  },
  "skillPaths": [
    ".claude/skills"
  ],
  "claims": [
    {
      "doc": "docs/ai-context/TESTING_GUIDE.md",
      "re": "Lines in test_vlm_rectifier\\.py\\s*\\|\\s*(\\d+)",
      "kind": "lines:backend/tests/test_vlm_rectifier.py"
    },
    {
      "doc": "docs/ai-context/ARCHITECTURE.md",
      "re": "PyMuPDF",
      "kind": "exists:backend/app/ingestion/pdf_inspector.py"
    },
    {
      "doc": "docs/ai-context/ARCHITECTURE.md",
      "re": "PaddleOCR",
      "kind": "exists:backend/app/ingestion/ocr_engine.py"
    }
  ],
  "gates": [
    {
      "id": "doc-truth",
      "cmd": "node",
      "args": ["scripts/doc-truth.mjs"],
      "cwd": ".",
      "tags": ["docs"],
      "requires": [],
      "env": {},
      "optional": false
    },
    {
      "id": "backend-lint",
      "cmd": ".venv/Scripts/ruff.exe",
      "args": ["check", "app/"],
      "cwd": "backend",
      "tags": ["lint", "backend"],
      "requires": ["backend/app"],
      "env": {},
      "optional": false
    },
    {
      "id": "corpus-audit",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_processed_data.py"],
      "cwd": ".",
      "tags": ["audit", "data"],
      "requires": ["data/processed"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "score-review",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_score_review.py"],
      "cwd": ".",
      "tags": ["audit", "data"],
      "requires": ["docs/quality/score_collision_decisions.json"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "vector-audit",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_vector_store.py"],
      "cwd": ".",
      "tags": ["audit", "vector"],
      "requires": ["data/qdrant_db"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "index-consistency",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_index_consistency.py"],
      "cwd": ".",
      "tags": ["audit", "vector"],
      "requires": ["data/bm25_index.json", "data/qdrant_db"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "security-audit",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_auth_matrix.py"],
      "cwd": ".",
      "tags": ["audit", "security"],
      "requires": ["backend/app/main.py", "backend/app/core/security.py"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "benchmark-truth",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_benchmark_truth.py"],
      "cwd": ".",
      "tags": ["audit", "benchmark"],
      "requires": [
        "data/benchmarks/ragas_milestone2_report.json",
        "data/benchmark_milestone3_report.json",
        "data/benchmarks/ocr_comparison/qwen3_vl_4b_report.json",
        "data/benchmarks/ocr_comparison/gemini_auditor_report.json"
      ],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "backend-tests",
      "cmd": ".venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/", "-q"],
      "cwd": "backend",
      "tags": ["backend"],
      "requires": ["backend/tests"],
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "id": "test-truth",
      "cmd": "backend/.venv/Scripts/python.exe",
      "args": ["scripts/audit_test_truth.py"],
      "cwd": ".",
      "tags": ["audit", "docs"],
      "requires": ["docs/ai-context/TESTING_GUIDE.md", "backend/tests", "frontend/tests"],
      "env": { "PYTHONUTF8": "1" },
      "optional": false
    },
    {
      "id": "frontend-tests",
      "cmd": "npm",
      "args": ["test"],
      "cwd": "frontend",
      "tags": ["frontend"],
      "requires": [],
      "env": {}
    }
  ]
}
