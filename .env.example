# Application Settings
ENVIRONMENT=development # development | production
APP_NAME="Vietnamese Document Intelligence (Scan2RAG)"
API_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL) - Tách biệt Test & Production
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/Scan2RAG_Test
DATABASE_URL_PRODUCTION=postgresql://user:password@production-host:5432/Scan2RAG_Prod
ACTIVE_DATABASE=test # 'test' hoặc 'production'

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=vietnamese_legal_docs

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Local LLM - LM Studio (OpenAI-compatible server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct # Tên model load trong LM Studio

# Cloud LLM Configuration (Sử dụng provider miễn phí / rẻ: Groq, OpenRouter)
DEFAULT_CLOUD_PROVIDER=groq # 'groq' hoặc 'openrouter'

# Groq API (Cực nhanh, có tier miễn phí rất tốt cho Llama 3 / Qwen)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile # hoặc qwen-2.5-32b

# OpenRouter API (Hỗ trợ nhiều free model: :free models)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OCR Configuration
OCR_ENGINE=PaddleOCR # PaddleOCR or Tesseract
USE_GPU_OCR=True

# Observability & Tracing - Langfuse (Tùy chọn: dùng để debug chuỗi RAG & Agent)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
